              <item>
               <property name="text">
                <string>normal parotid gland: homogenous hyperechoic pattern of internal echoes +/- insuspicous lymphnodes</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>parotitis/acute sialadenitis: hypoechoic , loosely structured tissue +/- lymphnodes</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>chronic sialadenitis: compact, inhomogenous/hypoechoic gland parenchyma, overall reduction in size</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>salivary gland stone: dense echo with dorsal acoustic shadowing in stenon duct, proximal duct dilatation </string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>obstructive sialopathy: papillar duct stasis with proximal duct dilatation w/o signs of a stone</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>benignoma: clearly defined (lobulated) tumor, hypoechoic or echogenic, no hilus, distal acoustic enhancement</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>infected benignoma: cleary defined tumor, hypoechoic + clinical signs of infection</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>suspicious tumor: ill-defined margins and polycyclic shape, inhomogenious/&quot;turbulent&quot; tissue, anterior or medial extension not defined</string>
